# Never commit a real value of any variable in this file.
OMI_BRIDGE_SECRET=replace-with-a-random-32-byte-secret
# Public HTTPS root after deploying or configuring a named tunnel.
OMI_BRIDGE_PUBLIC_URL=https://relay.example.com
# Separate key for the private desktop HTTP API. The Omi chat tools do not use it.
OMI_BRIDGE_DASHBOARD_KEY=replace-with-a-second-random-secret
# Optional. If empty, the first webhook that has the correct webhook secret pairs the relay to one Omi UID.
OMI_BRIDGE_ALLOWED_UID=
# Use a persistent mounted path in production. Do not use an ephemeral container filesystem.
OMI_BRIDGE_DB=/data/omi_bridge.db
OMI_BRIDGE_VAULT=/data/vault

